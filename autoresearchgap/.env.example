# Copy this file to .env and fill in ONE key (the one for the provider you use):
#   cp .env.example .env        (Windows: copy .env.example .env)

# Which LLM to use: anthropic | gemini | groq | openrouter | ollama
LLM_PROVIDER=gemini

# --- FREE options ---------------------------------------------------------
# Google Gemini (free tier)  -> https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (free tier)           -> https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter (':free' models)-> https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Ollama = local models, no key needed -> https://ollama.com/download

# --- Paid ---------------------------------------------------------------
# Claude -> https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the model name of the chosen provider
# LLM_MODEL=gemini-2.5-flash
